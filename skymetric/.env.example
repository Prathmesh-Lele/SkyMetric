# SkyMetric Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=sqlite:///skymetric.db

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# SerpApi key for live flight data (Tier 2 fallback)
# Get free key at https://serpapi.com (100-250 searches/month)
SERPAPI_KEY=

# Scraper mode: mock, playwright
SCRAPER_MODE=mock
